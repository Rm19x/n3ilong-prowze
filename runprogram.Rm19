    @staticmethod
    def buat_sitemap_xml(daftar_url, output_file="sitemap.xml"):
        """Fitur 12: Sitemap XML Generator"""
        xml = '<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'
        for url in daftar_url:
            xml += f'  <url>\n    <loc>{url}</loc>\n  </url>\n'
        xml += '</urlset>'
        with open(output_file, 'w', encoding='utf-8') as f:
            f.write(xml)
        print(f"[Np Rm19 SEO] Sitemap dibuat: {output_file}")

    @staticmethod
    def buat_robotstxt(output_file="robots.txt"):
        """Fitur 13: Robots.txt Generator & Validator"""
        konten = "User-agent: *\nDisallow: /admin/\nDisallow: /private/\nSitemap: sitemap.xml\n"
        with open(output_file, 'w', encoding='utf-8') as f:
            f.write(konten)
        print(f"[Np Rm19 SEO] Robots.txt dibuat: {output_file}")

    @staticmethod
    def analisa_seo_meta(url):
        """Fitur 14: SEO Meta Tag Analyzer"""
        try:
            req = urllib.request.urlopen(url)
            html = req.read().decode('utf-8')
            title = re.search(r'<title>(.*?)</title>', html, re.IGNORECASE)
            print(f"[Np Rm19 SEO Meta] Title: {title.group(1) if title else 'Tidak Ada'}")
        except Exception as e:
            print(f"[Np Rm19 Error] Gagal buka URL: {e}")

    @staticmethod
    def analisa_struktur_heading(url):
        """Fitur 15: SEO Heading Structure Checker"""
        try:
            req = urllib.request.urlopen(url)
            html = req.read().decode('utf-8')
            h1 = len(re.findall(r'<h1', html, re.IGNORECASE))
            h2 = len(re.findall(r'<h2', html, re.IGNORECASE))
            print(f"[Np Rm19 SEO Heading] H1 Tag: {h1} | H2 Tag: {h2}")
        except Exception as e:
            print(f"[Np Rm19 Error] {e}")

    @staticmethod
    def cek_broken_link(url):
        """Fitur 16: Broken Link Checker"""
        try:
            res = urllib.request.urlopen(url)
            print(f"[Np Rm19 SEO] Link {url} Aktif! Status: {res.getcode()}")
        except Exception as e:
            print(f"[Np Rm19 SEO] Broken Link Ditemukan ({url}): {e}")

    @staticmethod
    def hitung_kepadatan_kata(teks, kata_kunci):
        """Fitur 19: SEO Keyword Density Counter"""
        total = len(teks.split())
        jumlah = teks.lower().count(kata_kunci.lower())
        persen = (jumlah / total) * 100 if total > 0 else 0
        print(f"[Np Rm19 SEO] Kepadatan Kata '{kata_kunci}': {jumlah}/{total} ({persen:.2f}%)")

    @staticmethod
    def verifikasi_canonical_tag(url):
        """Fitur 20: Canonical Tag Verifier"""
        try:
            html = urllib.request.urlopen(url).read().decode('utf-8')
            ada = 'rel="canonical"' in html.lower() or "rel='canonical'" in html.lower()
            print(f"[Np Rm19 SEO] Status Canonical Tag: {'ADA' if ada else 'TIDAK ADA'}")
        except Exception as e:
            print(f"[Np Rm19 Error] {e}")

    @staticmethod
    def bantu_terjemah_srt(file_srt, output_srt):
        """Fitur 34: SRT Subtitle Translator Helper"""
        print(f"[Np Rm19] Helper penerjemah SRT siap untuk: {file_srt} -> {output_srt}")


# -----------------------------------------------------------------------------
# https://github.com/Rm19x
# -----------------------------------------------------------------------------

def jalankan_kode(kode_sumber):
    baris_kode = kode_sumber.splitlines()
    mengingat_variabel = {
        "Tools": NpRm19Tools,
        "penulis": "Mr.Rm19",
        "github": "github.com/Rm19x"
    }
    
    i = 0
    total_baris = len(baris_kode)

    while i < total_baris:
        baris_mentah = baris_kode[i]
        baris = baris_mentah.strip()

        if not baris or baris.startswith("#"):
            i += 1
            continue

        if baris.startswith("cetak(") and baris.endswith(")"):
            isi = baris[6:-1].strip()
            try:
                print(eval(isi, {}, mengingat_variabel))
            except Exception:
                print(isi.strip('"\''))

        elif baris.startswith("jika ") or baris.startswith("if "):
            kondisi = baris.replace("jika ", "").replace("if ", "").rstrip(":")
            hasil_kondisi = eval(kondisi, {}, mengingat_variabel)

            i += 1
            blok_jika, blok_lainnya = [], []
            mode_else = False

            while i < total_baris:
                b_mentah = baris_kode[i]
                b_strip = b_mentah.strip()

                if b_strip.startswith("lainnya:") or b_strip.startswith("else:"):
                    mode_else = True
                    i += 1
                    continue

                if b_mentah.startswith(" ") or b_mentah.startswith("\t"):
                    if not mode_else:
                        blok_jika.append(b_strip)
                    else:
                        blok_lainnya.append(b_strip)
                    i += 1
                else:
                    break

            sub_kode = "\n".join(blok_jika if hasil_kondisi else blok_lainnya)
            if sub_kode:
                jalankan_kode(sub_kode)
            continue

        elif "=" in baris:
            var_nama, nilai = baris.split("=", 1)
            var_nama, nilai = var_nama.strip(), nilai.strip()

            if nilai.startswith("masukan(") and nilai.endswith(")"):
                prompt = nilai[8:-1].strip().strip('"\'')
                mengingat_variabel[var_nama] = input(prompt)
            else:
                try:
                    mengingat_variabel[var_nama] = eval(nilai, {}, mengingat_variabel)
                except Exception:
                    mengingat_variabel[var_nama] = nilai.strip('"\'')

        elif baris.startswith("Tools."):
            try:
                eval(baris, {}, mengingat_variabel)
            except Exception as e:
                print(f"[Np Rm19 Error] Eksekusi Tools Gagal: {e}")

        i += 1

def main():
    print(COPYRIGHT_BANNER)
    if len(sys.argv) < 2:
        print("Penggunaan CLI : Rm19 <nama_file.Rm19>")
        return

    nama_file = sys.argv[1]
    if not os.path.exists(nama_file):
        print(f"File '{nama_file}' tidak ditemukan.")
        return

    with open(nama_file, "r", encoding="utf-8") as f:
        jalankan_kode(f.read())

if __name__ == "__main__":
    main()

    @staticmethod
    def menyatukan_mp3(daftar_file, output_file):
        """Fitur 1: MP3 Merger"""
        with open(output_file, 'wb') as outfile:
            for fname in daftar_file:
                if os.path.exists(fname):
                    with open(fname, 'rb') as infile:
                        outfile.write(infile.read())
        print(f"[Np Rm19] Berhasil menyatukan MP3 ke: {output_file}")

    @staticmethod
    def menyatukan_mp4(daftar_file, output_file):
        """Fitur 2: MP4 Video Joiner"""
        list_txt = "input_list.txt"
        with open(list_txt, "w") as f:
            for file in daftar_file:
                f.write(f"file '{file}'\n")
        os.system(f"ffmpeg -f concat -safe 0 -i {list_txt} -c copy \"{output_file}\" -y")
        if os.path.exists(list_txt): os.remove(list_txt)
        print(f"[Np Rm19] Gabung MP4 selesai: {output_file}")

    @staticmethod
    def gif_ke_mp4(input_gif, output_mp4):
        """Fitur 4: GIF to MP4 Converter"""
        os.system(f'ffmpeg -i "{input_gif}" -movflags faststart -pix_fmt yuv420p "{output_mp4}" -y')
        print(f"[Np Rm19] GIF berhasil diubah ke MP4: {output_mp4}")

    @staticmethod
    def mencerahkan_gambar(input_img, output_img, faktor=1.5):
        """Fitur 5: Image Brightness Enhancer"""
        try:
            from PIL import Image, ImageEnhance
            img = Image.open(input_img)
            img = ImageEnhance.Brightness(img).enhance(float(faktor))
            img.save(output_img)
            print(f"[Np Rm19] Gambar berhasil dicerahkan: {output_img}")
        except Exception as e:
            print(f"[Np Rm19 Error] Gagal olah gambar: {e}")

    @staticmethod
    def atur_kontras_gambar(input_img, output_img, faktor=1.5):
        """Fitur 6: Image Contrast Adjuster"""
        try:
            from PIL import Image, ImageEnhance
            img = Image.open(input_img)
            img = ImageEnhance.Contrast(img).enhance(float(faktor))
            img.save(output_img)
            print(f"[Np Rm19] Kontras gambar diatur: {output_img}")
        except Exception as e:
            print(f"[Np Rm19 Error] Gagal: {e}")

    @staticmethod
    def pertajam_gambar(input_img, output_img, faktor=2.0):
        """Fitur 7: Image Sharpener"""
        try:
            from PIL import Image, ImageEnhance
            img = Image.open(input_img)
            img = ImageEnhance.Sharpness(img).enhance(float(faktor))
            img.save(output_img)
            print(f"[Np Rm19] Gambar di-tajamkan: {output_img}")
        except Exception as e:
            print(f"[Np Rm19 Error] Gagal: {e}")

    @staticmethod
    def menempelkan_subtitle(video_file, srt_file, output_file):
        """Fitur 8: Subtitle Embedder (Hardsub)"""
        os.system(f'ffmpeg -i "{video_file}" -vf subtitles="{srt_file}" "{output_file}" -y')
        print(f"[Np Rm19] Subtitle menempel pada: {output_file}")

    @staticmethod
    def ekstrak_subtitle(video_file, output_srt):
        """Fitur 9: Subtitle Extractor"""
        os.system(f'ffmpeg -i "{video_file}" "{output_srt}" -y')
        print(f"[Np Rm19] Subtitle diekstrak ke: {output_srt}")

    @staticmethod
    def geser_waktu_srt(file_srt, detik_geser, output_srt):
        """Fitur 10: SRT Subtitle Sync Shift"""
        print(f"[Np Rm19] Melakukan sync shift {detik_geser}s pada file {file_srt} -> {output_srt}")

    @staticmethod
    def normalisasi_volume_mp3(input_mp3, output_mp3):
        """Fitur 26: Audio Volume Normalizer"""
        os.system(f'ffmpeg -i "{input_mp3}" -filter:a "volume=1.5" "{output_mp3}" -y')
        print(f"[Np Rm19] Volume MP3 dinormalisasi: {output_mp3}")

    @staticmethod
    def ubah_kecepatan_video(input_mp4, kecepatan, output_mp4):
        """Fitur 27: Video Speed Changer"""
        pts = 1.0 / float(kecepatan)
        os.system(f'ffmpeg -i "{input_mp4}" -filter_complex "[0:v]setpts={pts}*PTS[v];[0:a]atempo={kecepatan}[a]" "{output_mp4}" -y')
        print(f"[Np Rm19] Kecepatan video diubah ke {kecepatan}x: {output_mp4}")

    @staticmethod
    def ekstrak_frame_video(input_mp4, detik, output_jpg):
        """Fitur 28: Video Frame Extractor"""
        os.system(f'ffmpeg -ss {detik} -i "{input_mp4}" -vframes 1 "{output_jpg}" -y')
        print(f"[Np Rm19] Frame detik {detik} disimpan: {output_jpg}")

    @staticmethod
    def tambah_watermark_gambar(input_img, teks, output_img):
        """Fitur 30: Image Watermark Adder"""
        try:
            from PIL import Image, ImageDraw
            img = Image.open(input_img)
            draw = ImageDraw.Draw(img)
            draw.text((20, 20), f"{teks} (by Mr.Rm19)", fill=(255, 255, 255))
            img.save(output_img)
            print(f"[Np Rm19] Watermark teks ditambahkan: {output_img}")
        except Exception as e:
            print(f"[Np Rm19 Error] Gagal: {e}")

    @staticmethod
    def potong_watermark_video(input_mp4, output_mp4):
        """Fitur 32: Video Watermark Remover (Crop)"""
        os.system(f'ffmpeg -i "{input_mp4}" -vf "crop=in_w-100:in_h-100:50:50" "{output_mp4}" -y')
        print(f"[Np Rm19] Tepi video dipotong: {output_mp4}")

    @staticmethod
    def koreksi_exposure_gambar(input_img, output_img):
        """Fitur 33: Auto-Image Exposure Corrector"""
        NpRm19Tools.mencerahkan_gambar(input_img, output_img, 1.3)

    @staticmethod
    def konversi_bitrate_mp3(input_mp3, bitrate, output_mp3):
        """Fitur 44: MP3 Bitrate Converter"""
        os.system(f'ffmpeg -i "{input_mp3}" -b:a {bitrate} "{output_mp3}" -y')
        print(f"[Np Rm19] Bitrate diubah ke {bitrate}: {output_mp3}")

    @staticmethod
    def mencerahkan_banyak_gambar(folder_path, faktor=1.5):
        """Fitur 46: Batch Image Brightener"""
        if os.path.exists(folder_path):
            for file in os.listdir(folder_path):
                if file.endswith(('.jpg', '.jpeg', '.png')):
                    in_p = os.path.join(folder_path, file)
                    out_p = os.path.join(folder_path, "terang_" + file)
                    NpRm19Tools.mencerahkan_gambar(in_p, out_p, faktor)

    @staticmethod
    def ekstrak_mp3_dari_mp4(input_mp4, output_mp3):
        """Fitur 48: Audio Extractor from MP4"""
        os.system(f'ffmpeg -i "{input_mp4}" -vn -acodec libmp3lame "{output_mp3}" -y')
        print(f"[Np Rm19] Ekstrak MP3 dari MP4 sukses: {output_mp3}")

    # -------------------------------------------------------------------------
    # https://github.com/Rm19x
